# Template for .env, which is gitignored and never committed.
#
# You do not need to create .env by hand: ./start.sh generates one with
# randomly-generated passwords on first run. Copy this file only if you want
# to choose the values yourself.
#
#   cp .env.example .env   &&   edit
#
# Note the Metabase admin password must satisfy its complexity rules -
# upper, lower, digit and symbol - or first-time setup is rejected.

POSTGRES_USER=analytics
POSTGRES_PASSWORD=
POSTGRES_DB=invented_software

METABASE_EMAIL=analyst@invented.software
METABASE_PASSWORD=
